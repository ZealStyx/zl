// ============================================================================
// Regression fixture - valid/core_tests - Collections
//
// Deeper coverage of the built-in collection types than AllFeatures: bulk
// list operations, map removal and ordering, set add/remove semantics, and
// iterating every collection through the generic List returned by keys() /
// values() / items().
// ============================================================================

class Collections {
    func main(): void {
        // ---- list bulk operations ----
        var xs = new List<int>()
        xs.push(1)
        xs.push(2)
        xs.push(3)

        var ys = xs.slice(1, 3)
        log(ys.length())
        log(ys.get(0))

        var more = new List<int>()
        more.push(10)
        more.push(20)
        xs.extend(more)
        log(xs.length())
        log(xs.last())

        xs.insert(0, 99)
        log(xs.first())
        xs.removeAt(0)
        log(xs.first())

        log(xs.remove(2))
        log(xs.remove(12345))

        log(xs.isEmpty())
        log(new List<string>().firstOr("fallback"))

        var copy = xs.copy()
        copy.put(0, -1)
        log(copy.get(0))
        log(xs.get(0))

        // ---- map ordering and removal ----
        var m = new Map<string, int>()
        m.put("one", 1)
        m.put("two", 2)
        m.put("three", 3)
        m.put("one", 11)
        log(m.length())

        var keys = m.keys()
        for i in 0..keys.length() {
            log(keys.get(i))
        }

        var values = m.values()
        var total = 0
        for i in 0..values.length() {
            total = total + values.get(i)
        }
        log(total)

        // Map.remove/Set.remove return void (unlike List.remove, which is a
        // bool) - removal is verified through has()/length().
        m.remove("two")
        log(m.has("two"))
        log(m.length())

        // ---- set semantics ----
        var s = new Set<int>()
        for i in 0..5 {
            s.add(i % 3)
        }
        log(s.length())
        log(s.has(2))
        s.remove(2)
        log(s.has(2))
        log(s.length())

        // nested collections
        var grid = new List<List<int>>()
        var row = new List<int>()
        row.push(7)
        grid.push(row)
        log(grid.get(0).get(0))

        var lookup = new Map<string, List<int>>()
        var hits = new List<int>()
        hits.push(5)
        lookup.put("hits", hits)
        log(lookup.get("hits").get(0))
    }
}
