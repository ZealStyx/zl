// Previously recorded as limitation: passing a fixed array through the native
// Collection.* primitives was said to lose the element type (list<unknown>),
// which the MIR verifier would reject. Fixed by src/mir/type.cpp isCollectionType
// now including Array (case TypeKind::Array). This fixture now verifies clean
// and runs on both pipelines. Kept here as regression that the fix holds.
// See P1-5 in TASKS.md and docs/status/mir-safety-evaluation.md update.
class FixedArrayNative {
    func main(): void {
        array[5]<int> fixed = [1, 2, 3, 4, 5]
        log("len=" + Collection.length(fixed))
        log("last=" + Collection.get(fixed, 4))
    }
}
