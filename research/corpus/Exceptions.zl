// Corpus: exceptions.
// throw, try/catch, finally, custom exception types, error as control flow.
class LookupError extends Exception {
    func LookupError(string message): void {
        super(message)
    }
}

class Exceptions {
    static func risky(int n): int {
        if (n == 0) { throw new LookupError("zero is not allowed") }
        if (n < 0) { throw new Exception("negative is not allowed") }
        return 100 / n
    }

    func main(): void {
        log("ok=" + Exceptions.risky(4))

        try {
            log(Exceptions.risky(0))
        } catch LookupError e {
            log("lookup: " + e.message)
        }

        var cleaned = false
        try {
            log(Exceptions.risky(1))
        } catch Exception e {
            log("generic: " + e.message)
        } finally {
            cleaned = true
        }
        log("finally=" + cleaned)

        log("after=" + Exceptions.risky(2))
    }
}
