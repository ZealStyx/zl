// ============================================================================
// ZL Examples - Basics - Data Types
//
// The five primitives are int, double, decimal, bool and string.
//
// Two behaviours worth knowing early:
//
//   * int / int is INTEGER division: 7 / 2 is 3, not 3.5. Cast to double to get
//     a fractional result.
//   * Doubles print as the SHORTEST decimal that reads back as the same binary
//     double: log(3.14) prints 3.14, and log(0.1 + 0.2) prints
//     0.30000000000000004 because that digit is really there. No padding, no
//     rounding - and a whole-valued double prints without a fraction, so
//     log(7.0 / 2.0 - 1.5) prints 2.
// ============================================================================

class DataTypes {
    func main(): void {
        int whole = 7
        double part = 1.5
        bool flag = true
        string text = "ZL"

        log(whole)
        log(part)
        log(flag)
        log(text)

        log(7 / 2)          // integer division
        log(7 % 2)          // remainder
        log(7.0 / 2.0)      // real division
        log(3.14)           // shortest round-trip double formatting
    }
}

// --- Expected output (verified by examples/run_all.sh) ---
// 7
// 1.5
// true
// ZL
// 3
// 1
// 3.5
// 3.14
// --- End expected output ---
