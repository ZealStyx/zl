// ============================================================================
// ZL Examples - Basics - Data Types
//
// The five primitives are int, double, decimal, bool and string.
//
// Two behaviours worth knowing early:
//
//   * int / int is INTEGER division: 7 / 2 is 3, not 3.5. Cast to double to get
//     a fractional result.
//   * Doubles print with full round-trip precision, so 3.14 appears as
//     3.1400000000000001. That is the shortest decimal that reads back as the
//     same binary double - not a rounding bug in your program.
// ============================================================================

class DataTypes {
    func main(): void {
        int whole = 7
        double part = 1.5
        bool flag = true
        string text = "ZL"

        log(whole)
        log(part)
        log(flag)
        log(text)

        log(7 / 2)          // integer division
        log(7 % 2)          // remainder
        log(7.0 / 2.0)      // real division
        log(3.14)           // full-precision double formatting
    }
}

// --- Expected output (verified by examples/run_all.sh) ---
// 7
// 1.5
// true
// ZL
// 3
// 1
// 3.5
// 3.1400000000000001
// --- End expected output ---
