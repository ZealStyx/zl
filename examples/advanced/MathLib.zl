// ============================================================================
// ZL Examples - Advanced - Math
//
// `Math` is auto-imported - no import statement needed.
//
// Constants are fields, not functions: `Math.PI`, not `Math.PI()`.
//
//   sqrt abs pow floor ceil round min max trunc
//   clamp sign cbrt hypot gcd lcm
//   sin cos tan asin acos atan atan2
//   log log10 exp
//   lerp degrees radians
//   random randomInt(min,max) randomFloat(min,max)
//
// Some domain errors are reported rather than returning NaN silently: log/log10
// of a non-positive input throws, as do asin/acos outside [-1,1] and a
// clamp/random range whose minimum exceeds its maximum. `sqrt` is the exception
// - it returns nan for a negative argument instead of throwing, as shown below.
//
// Note that doubles print at full round-trip precision, so Math.PI appears as
// 3.1415926535897931.
// ============================================================================

class MathLib {
    func main(): void {
        log(Math.PI)
        log(Math.E)
        log(Math.TAU)

        log(Math.sqrt(16.0))
        log(Math.abs(-3))
        log(Math.pow(2.0, 10.0))
        log(Math.floor(2.7))
        log(Math.ceil(2.1))
        log(Math.round(2.5))
        log(Math.trunc(2.9))
        log(Math.min(3, 9))
        log(Math.max(3, 9))

        log(Math.clamp(15.0, 0.0, 10.0))
        log(Math.sign(-4.0))
        log(Math.cbrt(27.0))
        log(Math.hypot(3.0, 4.0))
        log(Math.gcd(12, 18))
        log(Math.lcm(4, 6))

        log(Math.lerp(0.0, 10.0, 0.25))
        log(Math.degrees(Math.PI))
        log(Math.radians(180.0))

        // sqrt of a negative does NOT throw - it yields nan.
        log(Math.sqrt(-1.0))

        // log of a non-positive input DOES throw.
        try {
            log(Math.log(-1.0))
        } catch Exception e {
            log("log domain error caught")
        }
    }
}

// --- Expected output (verified by examples/run_all.sh) ---
// 3.1415926535897931
// 2.7182818284590451
// 6.2831853071795862
// 4
// 3
// 1024
// 2
// 3
// 3
// 2
// 3
// 9
// 10
// -1
// 3.0000000000000004
// 5
// 6
// 12
// 2.5
// 180
// 3.1415926535897931
// nan
// log domain error caught
// --- End expected output ---
