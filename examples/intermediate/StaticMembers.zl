// ============================================================================
// ZL Examples - Intermediate - Static Members
//
// `static func` belongs to the class, not to an instance: call it through the
// class name with no receiver. A static function may not use `this` - doing so
// is a compile-time error.
//
// Static fields work the same way and support inherited qualified access: a
// derived class reading an inherited static field resolves it to the declaring
// class, so both names share one backing slot.
// ============================================================================

class StaticMembers {
    public static int instances
    static list<int> retained = [17]
    static list<int> failed = StaticMembers.failOnce()
    static int attempts = 0

    static func failOnce(): list<int> {
        StaticMembers.attempts = StaticMembers.attempts + 1
        throw new Exception("cached failure")
    }

    static func failureMessage(): string {
        try { log(StaticMembers.failed) }
        catch Exception error { return error.message }
        return "unexpected success"
    }

    static func pressure(): void {
        for i in 0..1200 { var garbage = [i, i + 1] }
    }

    static func valueAfterChild(): list<int> {
        var child = Thread.start(func() { StaticMembers.pressure() })
        return [23]
    }

    static func spawnThenThrow(): void {
        var child = Thread.start(func() { StaticMembers.pressure() })
        throw new Exception("unwind safely")
    }

    public static func clamp(int value, int lo, int hi): int {
        if (value < lo) { return lo }
        if (value > hi) { return hi }
        return value
    }

    public static func isPalindrome(string s): bool {
        var left = 0
        var right = String.length(s) - 1
        while (left < right) {
            if (String.substring(s, left, left + 1) != String.substring(s, right, right + 1)) {
                return false
            }
            left = left + 1
            right = right - 1
        }
        return true
    }

    func main(): void {
        log(StaticMembers.clamp(15, 0, 10))
        log(StaticMembers.clamp(-4, 0, 10))
        log(StaticMembers.clamp(5, 0, 10))

        log(StaticMembers.isPalindrome("racecar"))
        log(StaticMembers.isPalindrome("hello"))

        StaticMembers.instances = 3
        log(StaticMembers.instances)

        // No local keeps the static list/exception alive across this pressure.
        log("static before " + Collection.get(StaticMembers.retained, 0))
        log(StaticMembers.failureMessage())
        StaticMembers.pressure()
        log("static after " + Collection.get(StaticMembers.retained, 0))
        log(StaticMembers.failureMessage())
        log("initializer attempts " + StaticMembers.attempts)

        var done = new Shared<int>(0)
        Thread.start(func() {
            StaticMembers.pressure()
            done.setValue(1)
        })
        log("implicit join " + done.get())
        log("return across join " + Collection.get(StaticMembers.valueAfterChild(), 0))
        try { StaticMembers.spawnThenThrow() }
        catch Exception error { log(error.message) }
    }
}

// --- Expected output (verified by examples/run_all.sh) ---
// 10
// 0
// 5
// true
// false
// 3
// static before 17
// cached failure
// static after 17
// cached failure
// initializer attempts 1
// implicit join 1
// return across join 23
// unwind safely
// --- End expected output ---
