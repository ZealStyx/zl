// Shared module source for OperatorOverloading.zl - not a runnable example.
class Money {
    public int cents

    func Money(int cents): void {
        this.cents = cents
    }

    operator +(Money other): Money {
        return new Money(this.cents + other.cents)
    }

    operator -(Money other): Money {
        return new Money(this.cents - other.cents)
    }

    operator ==(Money other): bool {
        return this.cents == other.cents
    }

    public func toString(): string {
        return "Money(" + this.cents + ")"
    }
}
