// ============================================================================
// ZL Examples - Intermediate - match
//
// `match` is an expression: every arm produces a value, and the whole thing
// evaluates to it.
//
//   var label = match n {
//       1 => "one"
//       2 => "two"
//       _ => "other"        // wildcard - required, see below
//   }
//
// All arms must produce the same type. A guard is written `when` after the
// pattern. Bindings introduced by a variable pattern are scoped to their arm.
//
// EXHAUSTIVENESS IS CHECKED AT COMPILE TIME. A match that can fail to match any
// arm is rejected rather than falling through at runtime:
//
//   * open scalar spaces need a catch-all or covering type pattern
//   * bool needs true + false, a bool type pattern, or a catch-all
//   * enums need every member, a covering type pattern, or a catch-all
//   * unions need all alternatives; guards do not establish coverage
//   * nullable references (including string) also need null or a catch-all
//
// Type patterns narrow the subject and binding in their arm. Pattern bindings
// are copies, not aliases of outer variables with the same spelling. A guard
// that changes the subject invalidates narrowing of that original identifier.
// ============================================================================

enum Level { LOW MEDIUM HIGH }

class MatchExpressions {
    static func describe(int|string value): string {
        return match value {
            int _ => "number " + (value + 1)
            string text => String.upper(text)
            null => "missing"
        }
    }

    static func nameOf(int n): string {
        return match n {
            0 => "zero"
            1 => "one"
            2 => "two"
            _ => "many"
        }
    }

    static func size(int n): string {
        // A guard refines an arm without needing a separate pattern.
        return match n {
            v when v < 0 => "negative"
            0 => "zero"
            _ => "positive"
        }
    }

    static func label(Level level): string {
        // Every enum member is covered, so no wildcard is needed.
        return match level {
            Level.LOW => "low"
            Level.MEDIUM => "medium"
            Level.HIGH => "high"
        }
    }

    static func parity(bool flag): string {
        return match flag {
            true => "on"
            false => "off"
        }
    }

    func main(): void {
        log(MatchExpressions.nameOf(0))
        log(MatchExpressions.nameOf(2))
        log(MatchExpressions.nameOf(9))
        log(MatchExpressions.size(-3))
        log(MatchExpressions.size(0))
        log(MatchExpressions.size(4))
        log(MatchExpressions.label(Level.MEDIUM))
        log(MatchExpressions.parity(true))

        // A variable pattern binds the subject for the arm, and is irrefutable,
        // so it also serves as the catch-all.
        var n = 42
        var described = match n {
            0 => "nothing"
            v => "value " + v
        }
        log(described)
        log("union " + MatchExpressions.describe(4))
        log("union " + MatchExpressions.describe("hello"))
        log("union " + MatchExpressions.describe(null))
    }
}

// --- Expected output (verified by examples/run_all.sh) ---
// zero
// two
// many
// negative
// zero
// positive
// medium
// on
// value 42
// union number 5
// union HELLO
// union missing
// --- End expected output ---
