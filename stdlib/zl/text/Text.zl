// zl.text.Text - ZL-owned text convenience API.
// String.* remains the small native byte-string primitive boundary.
// Character indexing (length, charAt, substring, reverse, codePointAt, ...)
// is by Unicode scalar value; search helpers that return offsets
// (indexOf, lastIndexOf, indexOfFrom, indicesOf) report scalar indices too.
class Text {
    public static func length(string value): int { return String.utf8Length(value) }
    public static func isEmpty(string value): bool { return String.length(value) == 0 }
    public static func isNotEmpty(string value): bool { return String.length(value) != 0 }
    public static func upper(string value): string { return String.upper(value) }
    public static func lower(string value): string { return String.lower(value) }
    public static func trim(string value): string { return String.trim(value) }
    public static func isBlank(string value): bool { return String.trim(value) == "" }
    public static func repeatText(string value, int count): string {
        if count < 0 { throw new Exception("Text.repeat count must be non-negative") }
        // Linear-time native repeat: the old loop re-concatenated (and
        // re-copied) the whole accumulator per iteration, which is quadratic
        // and effectively hangs on large counts.
        return String.repeatText(value, count)
    }
    public static func contains(string value, string needle): bool { return String.contains(value, needle) }
    public static func indexOf(string value, string needle): int {
        var bytePos = String.indexOf(value, needle)
        if (bytePos < 0) { return -1 }
        return String.utf8IndexFromByte(value, bytePos)
    }
    public static func charAt(string value, int index): string { return String.utf8CharAt(value, index) }
    // Third argument is an exclusive end index in Unicode scalars, matching
    // String.substring's byte-range shape. `Text.substring("hello", 1, 3)` is "el".
    public static func substring(string value, int start, int length): string { return String.utf8Substring(value, start, length) }
    public static func replace(string value, string from, string to): string { return String.replace(value, from, to) }
    public static func remove(string value, string fragment): string { return String.replace(value, fragment, "") }
    public static func reverse(string value): string { return String.utf8Reverse(value) }
    public static func toInt(string value): int { return String.toInt(value) }
    public static func toFloat(string value): double { return String.toFloat(value) }
    public static func toBool(string value): bool { return Bool.parse(value) }
    public static func toIntOr(string value, int fallback): int { try { return String.toInt(value) } catch e { return fallback } }
    public static func toFloatOr(string value, double fallback): double { try { return String.toFloat(value) } catch e { return fallback } }
    public static func toBoolOr(string value, bool fallback): bool { try { return Bool.parse(value) } catch e { return fallback } }

    // The prefix/suffix primitives live in the native layer so the string
    // method surface (`s.startsWith(p)`, docs/language-guide.md#string-methods)
    // and this convenience wrapper are one implementation, not two.
    public static func startsWith(string value, string prefix): bool {
        return String.startsWith(value, prefix)
    }
    public static func endsWith(string value, string suffix): bool {
        return String.endsWith(value, suffix)
    }
    public static func count(string value, string needle): int {
        if (String.length(needle) == 0) { return 0 }
        var result = 0
        var start = 0
        while start <= String.length(value) - String.length(needle) {
            var remaining = String.substring(value, start, String.length(value))
            var found = String.indexOf(remaining, needle)
            if found < 0 { return result }
            result = result + 1
            start = start + found + String.length(needle)
        }
        return result
    }
    public static func padLeft(string value, int width, string fill): string {
        if String.utf8Length(fill) == 0 { throw new Exception("Text.padLeft fill must not be empty") }
        var missing = width - String.utf8Length(value)
        if missing <= 0 { return value }
        var prefix = ""
        var i = 0
        var fillLen = String.utf8Length(fill)
        while i < missing {
            prefix = prefix + String.utf8CharAt(fill, i % fillLen)
            i = i + 1
        }
        return prefix + value
    }
    public static func padRight(string value, int width, string fill): string {
        if String.utf8Length(fill) == 0 { throw new Exception("Text.padRight fill must not be empty") }
        var missing = width - String.utf8Length(value)
        if missing <= 0 { return value }
        var suffix = ""
        var i = 0
        var fillLen = String.utf8Length(fill)
        while i < missing {
            suffix = suffix + String.utf8CharAt(fill, i % fillLen)
            i = i + 1
        }
        return value + suffix
    }
    public static func join(List<string> parts, string separator): string {
        var result = ""
        for i in 0..parts.length() {
            if (i > 0) { result = result + separator }
            result = result + parts.get(i)
        }
        return result
    }

    // --- Splitting ---------------------------------------------------------
    // String.split returns the native list<string>; these return List<string>
    // so the result composes with the rest of the collection API.

    public static func split(string value, string separator): List<string> {
        var result = new List<string>()
        var raw = String.split(value, separator)
        for i in 0..Collection.length(raw) {
            result.push(Collection.get(raw, i))
        }
        return result
    }

    // A trailing newline terminates the last line rather than starting an
    // empty one, matching FileSystem.readLines.
    public static func lines(string value): List<string> {
        var result = Text.split(Text.replace(value, "\r\n", "\n"), "\n")
        if (result.length() > 0 && result.last() == "") { result.pop() }
        return result
    }

    // Splits on runs of whitespace and drops empty fragments.
    public static func words(string value): List<string> {
        var result = new List<string>()
        var current = ""
        for i in 0..String.utf8Length(value) {
            var c = String.utf8CharAt(value, i)
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                if (current != "") { result.push(current) }
                current = ""
            } else {
                current = current + c
            }
        }
        if (current != "") { result.push(current) }
        return result
    }

    public static func chars(string value): List<string> {
        var result = new List<string>()
        for i in 0..String.utf8Length(value) {
            result.push(String.utf8CharAt(value, i))
        }
        return result
    }

    // --- Trimming and affixes ----------------------------------------------

    public static func trimStart(string value): string { return String.trimStart(value) }
    public static func trimEnd(string value): string { return String.trimEnd(value) }

    public static func removePrefix(string value, string prefix): string {
        if (!Text.startsWith(value, prefix)) { return value }
        return String.substring(value, String.length(prefix), String.length(value))
    }

    public static func removeSuffix(string value, string suffix): string {
        if (!Text.endsWith(value, suffix)) { return value }
        return String.substring(value, 0, String.length(value) - String.length(suffix))
    }

    public static func ensurePrefix(string value, string prefix): string {
        if (Text.startsWith(value, prefix)) { return value }
        return prefix + value
    }

    public static func ensureSuffix(string value, string suffix): string {
        if (Text.endsWith(value, suffix)) { return value }
        return value + suffix
    }

    // --- Searching ----------------------------------------------------------

    public static func lastIndexOf(string value, string needle): int {
        var bytePos = String.lastIndexOf(value, needle)
        if (bytePos < 0) { return -1 }
        return String.utf8IndexFromByte(value, bytePos)
    }
    public static func indexOfFrom(string value, string needle, int start): int {
        var byteStart = String.utf8ByteIndex(value, start)
        var bytePos = String.indexOfFrom(value, needle, byteStart)
        if (bytePos < 0) { return -1 }
        return String.utf8IndexFromByte(value, bytePos)
    }

    public static func indicesOf(string value, string needle): List<int> {
        var result = new List<int>()
        if (String.utf8Length(needle) == 0) { return result }
        var from = 0
        var needleLen = String.utf8Length(needle)
        while (from <= String.utf8Length(value) - needleLen) {
            var found = Text.indexOfFrom(value, needle, from)
            if (found < 0) { return result }
            result.push(found)
            from = found + needleLen
        }
        return result
    }

    public static func containsAny(string value, List<string> needles): bool {
        for i in 0..needles.length() {
            if (String.contains(value, needles.get(i))) { return true }
        }
        return false
    }

    // --- Comparison ---------------------------------------------------------

    // -1 / 0 / 1, usable directly as a sort comparator input.
    public static func compare(string a, string b): int { return String.compare(a, b) }
    public static func compareIgnoreCase(string a, string b): int { return String.compareIgnoreCase(a, b) }
    public static func equalsIgnoreCase(string a, string b): bool { return String.compareIgnoreCase(a, b) == 0 }
    public static func containsIgnoreCase(string value, string needle): bool {
        return String.contains(String.lower(value), String.lower(needle))
    }
    public static func startsWithIgnoreCase(string value, string prefix): bool {
        return Text.startsWith(String.lower(value), String.lower(prefix))
    }
    public static func endsWithIgnoreCase(string value, string suffix): bool {
        return Text.endsWith(String.lower(value), String.lower(suffix))
    }

    // --- Case helpers --------------------------------------------------------

    public static func capitalize(string value): string {
        if (String.utf8Length(value) == 0) { return value }
        return String.upper(String.utf8CharAt(value, 0)) + String.utf8Substring(value, 1, String.utf8Length(value))
    }

    public static func title(string value): string {
        var parts = Text.words(value)
        var result = new List<string>()
        for i in 0..parts.length() {
            result.push(Text.capitalize(String.lower(parts.get(i))))
        }
        return Text.join(result, " ")
    }

    // --- Slicing and padding --------------------------------------------------

    // Clamps to the string's bounds instead of throwing, unlike substring.
    public static func slice(string value, int start, int end): string {
        var from = start
        var to = end
        var n = String.utf8Length(value)
        if (from < 0) { from = 0 }
        if (to > n) { to = n }
        if (to <= from) { return "" }
        return String.utf8Substring(value, from, to)
    }

    public static func take(string value, int count): string { return Text.slice(value, 0, count) }
    public static func drop(string value, int count): string { return Text.slice(value, count, String.utf8Length(value)) }

    public static func padCenter(string value, int width, string fill): string {
        var missing = width - String.utf8Length(value)
        if (missing <= 0) { return value }
        var left = missing / 2
        return Text.padRight(Text.padLeft(value, String.utf8Length(value) + left, fill), width, fill)
    }

    public static func truncate(string value, int width, string ellipsis): string {
        if (String.utf8Length(value) <= width) { return value }
        if (width <= String.utf8Length(ellipsis)) { return Text.take(ellipsis, width) }
        return Text.take(value, width - String.utf8Length(ellipsis)) + ellipsis
    }

    // --- Characters ------------------------------------------------------------

    public static func codePointAt(string value, int index): int { return String.utf8CodePointAt(value, index) }
    public static func fromCodePoint(int code): string { return String.utf8FromCodePoint(code) }

    public static func isDigits(string value): bool {
        if (String.utf8Length(value) == 0) { return false }
        for i in 0..String.utf8Length(value) {
            var code = String.utf8CodePointAt(value, i)
            if (code < 48 || code > 57) { return false }
        }
        return true
    }

    public static func isAlpha(string value): bool {
        if (String.utf8Length(value) == 0) { return false }
        for i in 0..String.utf8Length(value) {
            var code = String.utf8CodePointAt(value, i)
            var upper = code >= 65 && code <= 90
            var lower = code >= 97 && code <= 122
            if (!upper && !lower) { return false }
        }
        return true
    }

    // --- Formatting --------------------------------------------------------------
    // Text.format(pattern, list) is the native primitive and stays as-is.
    // This variant takes a List<string> so results of Text.split/words feed
    // straight into it without an unwrapping step.

    public static func formatAll(string pattern, List<string> values): string {
        var raw = Collection.newList()
        for i in 0..values.length() {
            Collection.push(raw, values.get(i))
        }
        return Text.format(pattern, raw)
    }
}
