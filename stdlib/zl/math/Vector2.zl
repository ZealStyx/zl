// ZL standard library Vector2<T,U>.
//
// T and U are inferred as numeric type parameters from the arithmetic used by
// this class. Concrete instantiation therefore rejects non-numeric component
// types at compile time.
class Vector2<T, U> {
    public T x
    public U y

    func Vector2(T x, U y): void {
        this.x = x
        this.y = y
    }

    public operator +(Vector2<T, U> other): Vector2<T, U> {
        return new Vector2<T, U>(this.x + other.x, this.y + other.y)
    }

    public operator -(Vector2<T, U> other): Vector2<T, U> {
        return new Vector2<T, U>(this.x - other.x, this.y - other.y)
    }

    // Scalar multiplication/division promote the result to double. This is
    // necessary for mixed component types and for normalization to preserve
    // fractional values even when the source vector uses integer components.
    public operator *(double other): Vector2<double, double> {
        return new Vector2<double, double>(this.x * other, this.y * other)
    }

    public operator /(double other): Vector2<double, double> {
        return new Vector2<double, double>(this.x / other, this.y / other)
    }

    public operator ==(Vector2<T, U> other): bool {
        return this.x == other.x && this.y == other.y
    }

    public operator !=(Vector2<T, U> other): bool {
        return !(this == other)
    }

    public func lengthSquared(): double {
        return Math.pow(this.x, 2.0) + Math.pow(this.y, 2.0)
    }

    public func length(): double {
        return Math.sqrt(this.lengthSquared())
    }

    public func normalize(): Vector2<double, double> {
        var len = this.length()
        if (len == 0.0) {
            return new Vector2<double, double>(0.0, 0.0)
        }
        return new Vector2<double, double>(this.x / len, this.y / len)
    }

    public func dot(Vector2<T, U> other): double {
        return Math.pow(this.x * other.x, 1.0) + Math.pow(this.y * other.y, 1.0)
    }

    public func distanceSquared(Vector2<T, U> other): double {
        return Math.pow(this.x - other.x, 2.0) + Math.pow(this.y - other.y, 2.0)
    }

    public func distance(Vector2<T, U> other): double {
        return Math.sqrt(this.distanceSquared(other))
    }
}
