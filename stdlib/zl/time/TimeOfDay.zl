import zl.time.Duration

// zl.time.TimeOfDay - clock-time view over epoch seconds.
//
// Only the local hour/minute/second are meaningful; the calendar date is
// ignored by every comparison, so 09:00 today equals 09:00 next year.
// Arithmetic wraps within the 24-hour day rather than rolling into the next
// date, since a TimeOfDay has no date to roll into.
class TimeOfDay {
    public int epoch

    func TimeOfDay(int epoch): void { this.epoch = epoch }

    // --- Construction ------------------------------------------------------

    // Builds a clock time directly. Values outside 0..23 / 0..59 are rejected
    // rather than silently normalized into a different time.
    public static func of(int hour, int minute, int second): TimeOfDay {
        if (hour < 0 || hour > 23) { throw new Exception("TimeOfDay.of: hour must be 0..23") }
        if (minute < 0 || minute > 59) { throw new Exception("TimeOfDay.of: minute must be 0..59") }
        if (second < 0 || second > 59) { throw new Exception("TimeOfDay.of: second must be 0..59") }
        return new TimeOfDay(Time.fromParts(1970, 1, 1, hour, minute, second))
    }

    public static func now(): TimeOfDay { return new TimeOfDay(Time.now()) }

    // --- Components --------------------------------------------------------

    public func hour(): int { return Time.hour(this.epoch) }
    public func minute(): int { return Time.minute(this.epoch) }
    public func second(): int { return Time.second(this.epoch) }

    // Seconds since local midnight; the canonical ordering key.
    public func totalSeconds(): int {
        return this.hour() * 3600 + this.minute() * 60 + this.second()
    }

    public func totalMinutes(): int { return this.totalSeconds() / 60 }

    // --- Rendering ---------------------------------------------------------

    public func format(string pattern): string { return Time.format(this.epoch, pattern) }
    public func iso(): string { return Time.format(this.epoch, "HH:mm:ss") }
    public func short(): string { return Time.format(this.epoch, "HH:mm") }
    public func toString(): string { return this.iso() }

    // --- Arithmetic (wraps within the day) ----------------------------------

    public func addSeconds(int seconds): TimeOfDay {
        var total = (this.totalSeconds() + seconds) % 86400
        if (total < 0) { total = total + 86400 }
        return TimeOfDay.of(total / 3600, (total % 3600) / 60, total % 60)
    }

    public func addMinutes(int minutes): TimeOfDay { return this.addSeconds(minutes * 60) }
    public func addHours(int hours): TimeOfDay { return this.addSeconds(hours * 3600) }
    public func subtractSeconds(int seconds): TimeOfDay { return this.addSeconds(-seconds) }
    public func subtractMinutes(int minutes): TimeOfDay { return this.addMinutes(-minutes) }
    public func subtractHours(int hours): TimeOfDay { return this.addHours(-hours) }

    // --- Differences ---------------------------------------------------------

    // Signed seconds from this clock time to `other`, within the same day.
    public func secondsUntil(TimeOfDay other): int {
        return other.totalSeconds() - this.totalSeconds()
    }

    public func difference(TimeOfDay other): Duration {
        return new Duration(this.secondsUntil(other) * 1000)
    }

    // --- Predicates -------------------------------------------------------------

    public func isMorning(): bool { return this.hour() < 12 }
    public func isAfternoon(): bool { return this.hour() >= 12 && this.hour() < 18 }
    public func isEvening(): bool { return this.hour() >= 18 }

    // --- Comparison ---------------------------------------------------------------

    public func compare(TimeOfDay other): int {
        var a = this.totalSeconds()
        var b = other.totalSeconds()
        if (a < b) { return -1 }
        if (a > b) { return 1 }
        return 0
    }

    public func isBefore(TimeOfDay other): bool { return this.compare(other) < 0 }
    public func isAfter(TimeOfDay other): bool { return this.compare(other) > 0 }
    public func equals(TimeOfDay other): bool { return this.compare(other) == 0 }
    public func isBetween(TimeOfDay start, TimeOfDay end): bool {
        return this.compare(start) >= 0 && this.compare(end) <= 0
    }
}
